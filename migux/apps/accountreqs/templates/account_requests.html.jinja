<table>
  {% for entry in account_requests %}
  <tr>
    <td>
      <input type="hidden" name="account_request_ids" value="{{ entry.account_request_id }}" data-bind-observe="account_request_id">
      <input type="checkbox" data-bind-checked="selected">
    </td>
    {% for field_content in entry %}
    <td>{{ field_content }}</td>
    {% endfor %}
    <td>
      <span class="sel-edit"></span>
    </td>
  </tr>
  {% endfor %}
</table>